# A minimal, disposable SSH target for integration tests.
#
# Two accounts exist so the connector's sudo path is exercised as well as the
# direct one: skmtest manages its own keys, and deploy's keys are managed by
# skmtest via sudo.
FROM alpine:3.20

RUN apk add --no-cache openssh openssh-server sudo bash coreutils shadow

RUN ssh-keygen -A

RUN adduser -D -s /bin/sh skmtest \
 && echo 'skmtest:testpass' | chpasswd \
 && adduser -D -s /bin/sh deploy \
 && echo 'deploy:testpass' | chpasswd \
 && echo 'skmtest ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/skmtest \
 && chmod 0440 /etc/sudoers.d/skmtest

RUN sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
 && sed -i 's/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
 && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
 && sed -i 's/^#*UsePAM.*/UsePAM no/' /etc/ssh/sshd_config

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
